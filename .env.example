PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/intellica?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_ORIGINS=https://your-domain.example
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@example.com
EMAIL_APP_PASSWORD=your_app_password
EMAIL_LOGO_URL=
LOG_LEVEL=info
JSON_LIMIT=1mb
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=12
ADMIN_REG_ID=admin
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=System Admin
